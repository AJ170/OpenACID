//@@PASS
// Bloom bright-pass. Pixels with alpha < 0.95 are eagle vision targets and get the
// eagle vision ramp instead of the bloom response.
#pragma vertex vert
#pragma fragment frag
#pragma multi_compile DOWNSAMPLE_OFF DOWNSAMPLE_ON
#include "UnityCG.cginc"
sampler2D _MainTex;
half4 _MainTex_TexelSize;
half _EagleVisionAmount;
sampler2D _EagleVisionTexture;
half4 _Threshold;
half4 _Exponent;
half4 _Intensity;
struct v2f
{
    float4 pos : SV_POSITION;
    half2 uv : TEXCOORD0;
#if defined(DOWNSAMPLE_ON)
    half2 uv1 : TEXCOORD1;
    half2 uv2 : TEXCOORD2;
    half2 uv3 : TEXCOORD3;
#endif
};
v2f vert(appdata_img v)
{
    v2f o;
    o.pos = UnityObjectToClipPos(v.vertex);
    o.uv = v.texcoord.xy;
#if defined(DOWNSAMPLE_ON)
    half2 t = abs(_MainTex_TexelSize.xy);
    o.uv1 = v.texcoord.xy + half2(t.x, 0.0);
    o.uv2 = v.texcoord.xy + half2(0.0, t.y);
    o.uv3 = v.texcoord.xy + t;
#endif
    return o;
}
half4 frag(v2f i) : SV_Target
{
    half4 color0 = tex2D(_MainTex, i.uv);
#if defined(DOWNSAMPLE_ON)
    half4 sum = color0 + tex2D(_MainTex, i.uv1) + tex2D(_MainTex, i.uv2) + tex2D(_MainTex, i.uv3);
    half4 color = half4(sum.rgb * 0.25, color0.a);
#else
    half4 color = color0;
#endif
    if (color0.a < 0.95)
        return tex2D(_EagleVisionTexture, half2(0.5, 1.0 - color0.a)) * _EagleVisionAmount;
    return pow(max(color - _Threshold, half4(0.0, 0.0, 0.0, 0.0)), _Exponent) * _Intensity;
}
