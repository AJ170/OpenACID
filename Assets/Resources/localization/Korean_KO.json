"8028":"\ub77c\uc774\uc13c\uc2a4\ub97c \ud655\uc778\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uad6c\uae00 \ud50c\ub808\uc774\uc5d0\uc11c Assassin's Creed\u00ae: Identity\ub97c \uad6c\ub9e4\ud558\uc2ed\uc2dc\uc624.",
"9771":"\uacbd\uace0: \uc571\uc744 \uc778\uc99d\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4!",
"9772":"\ub2e4\uc74c \uc9c0\uce68\uc5d0 \ub530\ub77c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uc2ed\uc2dc\uc624.\n- \uba3c\uc800 \ud398\uc774\uc2a4\ubd81, Uplay \ub610\ub294 \uc6e8\uc774\ubcf4(\uac8c\uc784 \ub0b4 \uc18c\uc15c \ud56d\ubaa9 \ud655\uc778)\uc5d0 \ub85c\uadf8\uc778\ud574\uc11c \uce90\ub9ad\ud130 \ubc0f \uac8c\uc784 \uc9c4\ud589\ub0b4\uc5ed\uc744 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624.\n- \ud604\uc7ac \ubc84\uc804\uc758 Assassin\u2019s Creed Identity\ub97c \uc0ad\uc81c\ud558\uc2ed\uc2dc\uc624.\n- \uacf5\uc2dd \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc2dc \ud55c\ubc88 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uc774\uc804\uc5d0 \uc0ac\uc6a9\ud588\ub358 \uc18c\uc15c \ub124\ud2b8\uc6cc\ud06c \uc11c\ube44\uc2a4\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130\ub97c \uc0dd\uc131\ud560 \ub54c \uc774\uc804 \uce90\ub9ad\ud130 \ubc0f \uc9c4\ud589 \ub0b4\uc5ed\uc744 \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uacbd\uace0: \uc989\uc2dc \ub2e4\uc74c \uc9c0\uce68\uc744 \ub530\ub77c \uc8fc\uc2dc\uae30\ub97c \uad8c\uace0\ud569\ub2c8\ub2e4. \ud604\uc7ac \uc0ac\uc6a9 \uc911\uc778 \uc571\uc740 2\ubc88\uc758 \uc7ac\uc2dc\uc791 \ud6c4\uc5d0\ub294 \ub354 \uc774\uc0c1 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc744 \uac83\uc785\ub2c8\ub2e4.\n",
"9773":"\uacbd\uace0: \uc0ac\uc6a9 \uc911\uc778 \uc571\uc774 \uc778\uc99d\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4!",
